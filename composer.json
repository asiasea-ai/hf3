{
    "name": "asiasea-ai/hf3",
    "description": "基于 Hyperf 3.2 / Swoole 协程的微服务基础库:Controller→Gateway→Service→Dao→Model 分层基类、JWT 鉴权、限流、统一异常体系、表结构内省与 OpenAPI 文档生成。",
    "type": "library",
    "keywords": [
        "php",
        "hyperf",
        "swoole",
        "coroutine",
        "microservice",
        "framework"
    ],
    "homepage": "https://github.com/asiasea-ai/hf3",
    "license": "MIT",
    "authors": [
        {
            "name": "asiasea-ai",
            "email": "asiasea.ai@gmail.com",
            "homepage": "https://github.com/asiasea-ai"
        }
    ],
    "support": {
        "issues": "https://github.com/asiasea-ai/hf3/issues",
        "source": "https://github.com/asiasea-ai/hf3"
    },
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Hf3\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
